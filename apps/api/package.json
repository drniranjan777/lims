{
  "name": "@lims/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed": "tsx --env-file=../../.env prisma/seed.ts",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@lims/shared": "*",
    "@prisma/client": "^6.16.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.6",
    "pdfmake": "^0.2.20",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^7.0.1",
    "@types/pdfmake": "^0.2.11",
    "@types/supertest": "^6.0.3",
    "dotenv-cli": "^10.0.0",
    "prisma": "^6.16.0",
    "supertest": "^7.1.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
