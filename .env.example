# Copy to .env and fill in. Never commit .env.
NODE_ENV=development

# PostgreSQL connection strings
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/lims?schema=public
# Separate database used by the API integration test-suite (it is wiped by tests)
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/lims_test?schema=public

API_PORT=4000
# Browser origin of the Next.js app (used for CORS/CSRF origin checks and email links)
WEB_ORIGIN=http://localhost:3000
# URL the Next.js server uses to reach the API (rewrites /api/* to it)
API_INTERNAL_URL=http://localhost:4000

# Long random string (>= 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_TTL_HOURS=10

# Directory for uploaded files and generated PDFs (relative to apps/api or absolute)
STORAGE_DIR=./storage

# Initial administrator created by `npm run db:seed`
SEED_ADMIN_EMAIL=admin@lucidlabs.local
SEED_ADMIN_PASSWORD=
# Create one demo user per role (development / UAT only — set false in production)
SEED_DEMO_USERS=false
SEED_DEMO_PASSWORD=

# SMTP for customer / staff e-mail. When SMTP_HOST is empty, e-mails are kept in the
# outbox with status NOT_CONFIGURED (visible in Admin → E-mail outbox) instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LIMS <no-reply@example.com>
